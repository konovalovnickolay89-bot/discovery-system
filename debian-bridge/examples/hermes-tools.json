{
  "name": "casual-board-bridge",
  "description": "Outbound Debian bridge for Casual Board — long-poll jobs, signed results. Hermes/mpv not claimed verified.",
  "base_url_env": "CASUAL_BOARD_API_URL",
  "auth": {
    "header": "Authorization",
    "scheme": "Bearer",
    "token_env": "CASUAL_BOARD_BRIDGE_TOKEN"
  },
  "notes": [
    "No public inbound port on Debian.",
    "Host-facing work is leased from GET /v1/bridge/jobs/lease.",
    "Results must be HMAC-signed with CASUAL_BOARD_BRIDGE_TOKEN.",
    "Approvals use CASUAL_BOARD_TOKEN on the owner/admin side only — never in the browser.",
    "Stub executor only until a real Hermes/mpv path is verified on Debian."
  ],
  "allowlist": [
    "status",
    "capture",
    "add_today",
    "remove_today",
    "set_media",
    "set_machine"
  ],
  "tools": [
    {
      "name": "bridge_lease_job",
      "method": "GET",
      "path": "/v1/bridge/jobs/lease",
      "query": { "worker_id": "hermes", "timeout_s": 25 }
    },
    {
      "name": "bridge_post_result",
      "method": "POST",
      "path": "/v1/bridge/jobs/result",
      "body": {
        "job_id": "{{job_id}}",
        "status": "{{status}}",
        "result": {},
        "signature": "{{hmac}}",
        "worker_id": "hermes",
        "executor_note": "stub — Hermes/mpv not claimed verified"
      }
    },
    {
      "name": "owner_approve_job",
      "method": "POST",
      "path": "/v1/actions/{{job_id}}/approval",
      "auth_env": "CASUAL_BOARD_TOKEN",
      "body": { "approve": true, "note": "owner approved" }
    }
  ]
}
