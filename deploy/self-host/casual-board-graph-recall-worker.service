[Unit]
Description=Casual Board Graph Recall culinary worker (loopback only)
After=network-online.target casual-board-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/casual-board/debian-graph-recall-worker
EnvironmentFile=%h/.config/casual-board/graph-recall-worker.env
# HOME and HERMES_HOME must be set in EnvironmentFile
ExecStart=/opt/casual-board/debian-graph-recall-worker/.venv/bin/python -m casual_board_graph_recall_worker run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
# No new public ports — only loopback API + outbound model inference via Hermes

[Install]
WantedBy=default.target
